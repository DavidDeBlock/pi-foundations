---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'start' | 'center';
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'start',
} = Astro.props;
---
<section class={`hero container ${align === 'center' ? 'hero--center' : ''}`}>
  <div class="hero__inner">
    <div>
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1 class="hero__title" set:html={title} />
      {subtitle && <p class="hero__subtitle">{subtitle}</p>}
      <div class="hero__actions">
        <slot name="actions" />
      </div>
    </div>
    <aside class="hero__art" aria-hidden="true">
      <slot name="art">
        <svg
          viewBox="0 0 360 260"
          width="100%"
          role="img"
          aria-label="Schets van een workflow"
        >
          <defs>
            <marker
              id="arrow-end"
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="6"
              markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#2a241c" />
            </marker>
          </defs>

          <!-- sticky note 1 -->
          <g transform="translate(20,30) rotate(-2)">
            <rect width="100" height="78" fill="#c8552b" opacity="0.85" />
            <rect width="100" height="78" fill="none" stroke="#2a241c" stroke-width="1.5" />
            <text x="50" y="32" text-anchor="middle" font-family="Georgia, serif" font-size="14" fill="#f6efe1">Klant belt</text>
            <text x="50" y="54" text-anchor="middle" font-family="Georgia, serif" font-size="11" fill="#f6efe1" font-style="italic">"Mijn fiets remt raar"</text>
          </g>

          <!-- index card 1 -->
          <g transform="translate(160,30)">
            <rect width="120" height="78" fill="#f1e7d3" stroke="#2a241c" stroke-width="1.5" />
            <text x="10" y="20" font-family="IBM Plex Mono, monospace" font-size="9" fill="#3a6b8c" letter-spacing="2">INTAKE</text>
            <text x="10" y="42" font-family="Georgia, serif" font-size="12" fill="#2a241c">Naam, fiets, klacht</text>
            <text x="10" y="60" font-family="Georgia, serif" font-size="12" fill="#2a241c">Foto, termijn, prijs</text>
          </g>

          <!-- arrow -->
          <line x1="125" y1="68" x2="155" y2="68" stroke="#2a241c" stroke-width="1.5" marker-end="url(#arrow-end)" />

          <!-- sticky note 2 -->
          <g transform="translate(20,140) rotate(1.5)">
            <rect width="100" height="78" fill="#3a6b8c" opacity="0.85" />
            <rect width="100" height="78" fill="none" stroke="#2a241c" stroke-width="1.5" />
            <text x="50" y="32" text-anchor="middle" font-family="Georgia, serif" font-size="14" fill="#f6efe1">Planning</text>
            <text x="50" y="54" text-anchor="middle" font-family="Georgia, serif" font-size="11" fill="#f6efe1" font-style="italic">in de werkplaats</text>
          </g>

          <!-- arrow 2 -->
          <line x1="125" y1="178" x2="155" y2="178" stroke="#2a241c" stroke-width="1.5" marker-end="url(#arrow-end)" />

          <!-- index card 2 -->
          <g transform="translate(160,140)">
            <rect width="120" height="78" fill="#f1e7d3" stroke="#2a241c" stroke-width="1.5" />
            <text x="10" y="20" font-family="IBM Plex Mono, monospace" font-size="9" fill="#6b8f5a" letter-spacing="2">KLAAR</text>
            <text x="10" y="42" font-family="Georgia, serif" font-size="12" fill="#2a241c">Klant krijgt bericht</text>
            <text x="10" y="60" font-family="Georgia, serif" font-size="12" fill="#2a241c">Afrekenen, factuur</text>
          </g>

          <!-- bottom note -->
          <text x="20" y="248" font-family="IBM Plex Mono, monospace" font-size="10" fill="#756553" letter-spacing="1.5">
            van idee tot routine
          </text>
        </svg>
      </slot>
    </aside>
  </div>
</section>
