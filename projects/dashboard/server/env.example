# Dashboard server — environment template
#
# Usage:
#   cp env.example .env
#   ${EDITOR} .env          # fill in the values
#   pnpm start
#
# Rules:
#   - Lines starting with `#` are comments.
#   - Format is KEY=value, one per line.
#   - Shell env vars (export FOO=bar) WIN over this file's values.
#   - Set DASHBOARD_ENV_FILE to point at a different location.

# ─── Required ────────────────────────────────────────────────────────────

# The HTTP Basic password the human uses. Bcrypt-hashed in memory at
# startup; never logged.
DASHBOARD_PASSWORD=replace-me

# ─── Email (required for Gmail mirroring) ────────────────────────────────

# 64 hex characters (32 bytes). AES-256-GCM key for at-rest encryption
# of OAuth tokens. Generate with `pnpm keygen` or `openssl rand -hex 32`.
# Rotate every 12 months (deferred slice). Losing this key locks you
# out of stored OAuth credentials.
EMAIL_TOKEN_ENCRYPTION_KEY=

# OAuth client id from the Google Cloud Console.
# Create one at https://console.cloud.google.com/apis/credentials
# Choose "Web application" and add the EMAIL_OAUTH_REDIRECT_URI below
# as an Authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=

# OAuth client secret from the same page.
GOOGLE_OAUTH_CLIENT_SECRET=

# Full callback URL. Must match a value registered in the Google Cloud
# Console byte-for-byte. Common options:
#   Same-machine:  http://localhost:8080/api/email/oauth/callback
#   LAN testing:   https://192.168.0.136.nip.io:8080/api/email/oauth/callback
#   Production:    https://mail.example.com/api/email/oauth/callback
# See /settings/email for the full redirect-URI rules.
EMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/api/email/oauth/callback

# ─── Optional ────────────────────────────────────────────────────────────

# Initial-sync lookback window in days (default 90). Used only on the
# first sync for an account; subsequent syncs use the persisted cursor
# and ignore this value.
EMAIL_SYNC_HISTORY_DAYS=90

# TLS cert + key paths. Required for any non-loopback redirect URI
# (LAN testing, production). Generate cert + key with:
#   pip install trustme && python -c "..."    # see /settings/email
#   # or:
#   brew install mkcert && mkcert -install && mkcert 192.168.0.136.nip.io
# Both vars must be set together. Set neither for plain HTTP.
# DASHBOARD_TLS_CERT=/absolute/path/to/server.pem
# DASHBOARD_TLS_KEY=/absolute/path/to/server.key

# TCP port to listen on (default 8080).
PORT=8080

# Bind address. 0.0.0.0 is fine for a LAN box; switch to 127.0.0.1
# if fronted by a reverse proxy on the same host.
HOSTNAME=0.0.0.0

# Where the JSON token store + SQLite file live.
DASHBOARD_DATA_DIR=./data
DASHBOARD_DB_PATH=./data/dashboard.db